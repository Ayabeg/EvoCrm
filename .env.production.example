APP_NAME="EvoSales · Evotechly"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.evotechly.com
APP_TIMEZONE=Africa/Algiers
PORT=8000

# Algeria soft-launch default. Missing keys fall back to English chrome.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Web, queue, and scheduler must share this durable SQL database.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=evosales
DB_USERNAME=
DB_PASSWORD=

# Database-backed sessions, queues, cache, and scheduler locks require the
# sessions, jobs, failed_jobs, job_batches, cache, and cache_locks migrations.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Provider credentials remain empty in source control. Copy the required
# values from the existing production secret store, never from this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty derives https://crm.evotechly.com/auth/google/callback from APP_URL.
# That exact URI must be listed on the Google OAuth client or sign-in
# returns Error 400 redirect_uri_mismatch.
GOOGLE_REDIRECT_URI=
GOOGLE_PLACES_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://crm.evotechly.com/auth/meta/callback
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=evosales
# Provisioned per workspace; never use a global unscoped webhook URL.
EVOLUTION_WEBHOOK_URL=
# PostHog Scale data hub — required in production so CRM, Meta, WhatsApp,
# outbound, and error tracking land in the Evotechly project.
POSTHOG_API_KEY=phc_zQkT5Qx8pfPRocL9puxTC7PFaciL4Q77MmTWzytXXKK5
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY="${POSTHOG_API_KEY}"
VITE_POSTHOG_HOST="${POSTHOG_HOST}"

EVOSALES_MAIL_API_URL=https://outbound.evotechly.com
EVOSALES_MAIL_API_TOKEN=
EVOSALES_SMTP_HOST=outbound.evotechly.com
EVOSALES_IMAP_HOST=outbound.evotechly.com
