APP_NAME="EvoCrm · Evotechly"
APP_ENV=production
EVOCRM_SIGNUP_MODE=invite
EVOCRM_SIGNUP_REQUEST_URL=mailto:hello@evotechly.com
TRUSTED_PROXIES=*
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.evotechly.com
APP_TIMEZONE=Africa/Algiers
PORT=8000

# Algeria soft-launch default. Missing keys fall back to English chrome.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Web, queue, and scheduler must share this durable SQL database.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=evosales
DB_USERNAME=
DB_PASSWORD=

# Database-backed sessions, queues, cache, and scheduler locks require the
# sessions, jobs, failed_jobs, job_batches, cache, and cache_locks migrations.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
# Must exceed the longest mutating job timeout; see docs/production-processes.md.
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Provider credentials remain empty in source control. Copy the required
# values from the existing production secret store, never from this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty derives https://crm.evotechly.com/auth/google/callback from APP_URL.
# That exact URI must be listed on the Google OAuth client or sign-in
# returns Error 400 redirect_uri_mismatch.
GOOGLE_REDIRECT_URI=
GOOGLE_PLACES_API_KEY=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://crm.evotechly.com/auth/meta/callback
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=evosales
# Provisioned per workspace; never use a global unscoped webhook URL.
EVOLUTION_WEBHOOK_URL=
# PostHog Scale data hub — required in production so CRM, Meta, WhatsApp,
# outbound, and error tracking land in the Evotechly project.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_IDENTIFY_PII=false
VITE_POSTHOG_KEY="${POSTHOG_API_KEY}"
VITE_POSTHOG_HOST="${POSTHOG_HOST}"

# --- Transactional mail (Resend Pro) ---
# Meetings, quotes, workspace invites, Fortify auth. Verified domain required
# (evocrmapp.com). Sequences / warmup stay on outbound.evotechly.com SMTP.
# Copy RESEND_API_KEY from the secret store — never commit a real key.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=no-reply@evocrmapp.com
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_FROM_ADDRESS=support@evocrmapp.com
RESEND_API_KEY=
# RESEND_KEY=

# --- Sequence / warmup SMTP (EvoOutreach) — not the transactional mailer ---
EVOSALES_MAIL_API_URL=https://outbound.evotechly.com
EVOSALES_MAIL_API_TOKEN=
# Keep consent-only outbound enabled unless the intended market has a
# documented lawful-basis review for cold B2B outreach.
EVOSALES_REQUIRE_MARKETING_CONSENT=true
EVOSALES_SMTP_HOST=outbound.evotechly.com
EVOSALES_IMAP_HOST=outbound.evotechly.com
