# Public API base URLs only. Never put Laravel APP_KEY, Sanctum secrets,
# Meta/Evolution/SMTP credentials, or provider tokens here.
# EXPO_PUBLIC_ values are inlined into the client bundle.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_STAGING_API_URL=https://staging.example.com/api/v1
EXPO_PUBLIC_PRODUCTION_API_URL=https://app.example.com/api/v1
