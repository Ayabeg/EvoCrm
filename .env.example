APP_NAME="EvoSales · Evotechly"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Algiers
PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Google sign-in (Laravel Socialite) ---
# Leave empty to hide the "Continue with Google" button (routes 404, no 500s).
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application):
#   Authorized JavaScript origin:  https://crm.evotechly.com
#   Authorized redirect URI:       https://crm.evotechly.com/auth/google/callback
# For local dev, add http://localhost:8000 as a JS origin and
# http://localhost:8000/auth/google/callback as a redirect URI, then set
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.evotechly.com/auth/google/callback

# --- Evolution API (WhatsApp Cloud / Business API only) ---
# Leave empty for a clear "not connected" state. Never invent Meta IDs.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=evosales
EVOLUTION_WEBHOOK_URL="${APP_URL}/webhooks/evolution"
EVOLUTION_TIMEOUT=15

# Meta Cloud credentials consumed by Evolution WHATSAPP-BUSINESS instances
WA_BUSINESS_TOKEN=
WA_BUSINESS_PHONE_NUMBER_ID=
WA_BUSINESS_WABA_ID=
WA_BUSINESS_GRAPH_VERSION=v21.0
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_LANGUAGE=fr

# Sold Desk is EvoDesk (Chatwoot Community MIT), embedded in-app at /inbox.
# Operators stay on the CRM hostname — this URL is the iframe source, not a
# nav target. Clear it to serve the native CRM desk at /inbox instead.
# If EvoDesk sends X-Frame-Options, allow-frame the CRM origin on the desk.
EVOSALES_INBOX_URL=https://desk.evotechly.com
# Optional path appended for the embed (Chatwoot serves the agent app at /app).
EVOSALES_INBOX_EMBED_PATH=/
EVODESK_URL=https://desk.evotechly.com

# --- Meta Marketing API (Ads Center) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0
META_LEAD_INGEST_TOKEN=

# Quiet hours (Africa/Algiers)
EVOSALES_COMPANY=Evotechly
EVOSALES_QUIET_START=21:00
EVOSALES_QUIET_END=08:00
