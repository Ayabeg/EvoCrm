APP_NAME="EvoCrm · Evotechly"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Customer-facing origin for booking / share links when APP_URL is loopback.
APP_PUBLIC_ORIGIN=https://app.evocrmapp.com
APP_TIMEZONE=Africa/Algiers
PORT=8000

# Invite-only pilot by default. Set to "open" to allow public /register
# and OAuth workspace creation. Invites still work in either mode.
EVOCRM_SIGNUP_MODE=invite
EVOCRM_SIGNUP_REQUEST_URL=mailto:hello@evotechly.com

# Reverse-proxy trust. "*" matches the current Contabo nginx hop; set
# explicit IPs or "none" to tighten. Read from config, not hardcoded.
TRUSTED_PROXIES=*

# Algeria soft-launch default. Missing keys fall back to English chrome.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest mutating job timeout; see docs/production-processes.md.
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Transactional mail (Laravel default mailer) ---
# Local: log (writes to storage/logs, never leaves the box).
# Production Contabo: MAIL_MAILER=resend + RESEND_API_KEY + a verified FROM.
# Laravel reads RESEND_API_KEY (https://laravel.com/docs/13.x/mail#resend-driver).
# RESEND_KEY is accepted as an alias. Do not put real keys in this file.
# Sequences / warmup stay on outbound.evotechly.com SMTP below — not Resend.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@evocrmapp.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_FROM_ADDRESS="support@evocrmapp.com"
RESEND_API_KEY=
# RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Google sign-in (Laravel Socialite) ---
# Leave empty to hide the "Continue with Google" button (routes 404, no 500s).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application) — the URI must match character-for-character:
#   Authorized JavaScript origin:  ${APP_URL}  (no path)
#   Authorized redirect URI:       ${APP_URL}/auth/google/callback
# Error 400 redirect_uri_mismatch means that exact redirect URI is missing
# on this client. Leave GOOGLE_REDIRECT_URI empty to derive it from APP_URL.
# For local + production on one client, add both origins and both callbacks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Extra scopes on that same OAuth client. Leave empty until Gmail / Calendar
# APIs are enabled on the client — login never requests these.
GOOGLE_GMAIL_SCOPE=
GOOGLE_CALENDAR_SCOPE=
# Official Places API (New) key for E1 enrichment. Empty = Places no-ops.
GOOGLE_PLACES_API_KEY=

# --- Sign in with Apple (SocialiteProviders) ---
# The Apple button is always shown. Leave these empty to send /auth/apple
# back to /login with "Apple sign-in isn't available yet." (never a 500).
# Apple Developer → Certificates, Identifiers & Profiles:
#   APPLE_CLIENT_ID     Services ID (e.g. com.evocrm.service)
#   APPLE_TEAM_ID       Membership Team ID
#   APPLE_KEY_ID        Key ID of the Sign in with Apple .p8 key
#   APPLE_PRIVATE_KEY   Absolute path to AuthKey_XXXX.p8, or the PEM body
#   APPLE_REDIRECT_URI  ${APP_URL}/auth/apple/callback (must match Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# --- Evolution API (platform only — clients never see these) ---
# WhatsApp (QR / WHATSAPP-BAILEYS) + WhatsApp Business (Cloud / WHATSAPP-BUSINESS).
# Leave empty to show "Evotechly is enabling it" — never invent Meta IDs.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=evosales
# Provisioned per workspace when Settings → Evolution is synchronized.
EVOLUTION_WEBHOOK_URL=
EVOLUTION_TIMEOUT=15

# Meta Cloud credentials consumed by Evolution WHATSAPP-BUSINESS instances
WA_BUSINESS_TOKEN=
WA_BUSINESS_PHONE_NUMBER_ID=
WA_BUSINESS_WABA_ID=
WA_BUSINESS_GRAPH_VERSION=v21.0
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_LANGUAGE=fr

# Sold Desk is EvoDesk (Chatwoot Community MIT), embedded in-app at /inbox.
# Operators stay on the CRM hostname — this URL is the iframe source, not a
# nav target. Clear it to serve the native CRM desk at /inbox instead.
# If EvoDesk sends X-Frame-Options, allow-frame the CRM origin on the desk.
# Laravel sets frame-ancestors for evocrmapp.com / crm.evotechly.com and
# frame-src for the desk. The desk vhost on Contabo must send the same
# ancestors — see docs/desk-iframe-headers.md.
EVOSALES_INBOX_URL=https://desk.evotechly.com
# Optional path appended for the embed (Chatwoot serves the agent app at /app).
EVOSALES_INBOX_EMBED_PATH=/
EVODESK_URL=https://desk.evotechly.com
# Optional extra CSP origins (comma-separated). Defaults are hardcoded.
# EVOSALES_FRAME_ANCESTORS=
# EVOSALES_FRAME_SRC=

# --- Meta (Evotechly platform app only) ---
# Paying clients only click Continue with Facebook. They never see these values.
# Set once on the server. Never ask a workspace for an App ID or user token.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://crm.evotechly.com/auth/meta/callback
META_GRAPH_VERSION=v21.0
# Shared verify token for GET /webhooks/meta/leads/{webhookKey}?hub.mode=subscribe
# Meta App Dashboard → Webhooks. The per-workspace webhook key also works.
META_WEBHOOK_VERIFY_TOKEN=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://crm.evotechly.com/auth/instagram/callback

# Optional webmail (Roundcube) link on the Email / SMTP app card.
WEBMAIL_URL=

# Optional Ask Evo live completion on contact/deal records.
# Empty = deterministic summary from this record's fields (no vendor call).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Agent runtime (isolated Python service). Default stays off.
# LLM keys belong in services/openmanus/config.toml, not here.
OPENMANUS_ENABLED=false
OPENMANUS_URL=http://127.0.0.1:8001
OPENMANUS_API_TOKEN=
OPENMANUS_TIMEOUT=120
OPENMANUS_HEALTH_TIMEOUT=3

# --- Algeria SMS (DZ HTTP aggregator by default) ---
# Desk replies stub locally when empty. Sequences never stub — they fail until
# a gateway is set here or in Settings → SMS. Twilio is opt-in.
SMS_DRIVER=http
SMS_SENDER=EVOTECHLY
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_KEY=
SMS_HTTP_AUTH=form
SMS_HTTP_FIELD_TO=to
SMS_HTTP_FIELD_MESSAGE=message
SMS_HTTP_FIELD_SENDER=sender
SMS_HTTP_FIELD_KEY=api_key
# Optional Twilio fallback (SMS_DRIVER=twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- PostHog (Evotechly data hub, US Cloud) ---
# Project token is a public client key. Empty disables capture.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_IDENTIFY_PII=false
VITE_POSTHOG_KEY="${POSTHOG_API_KEY}"
VITE_POSTHOG_HOST="${POSTHOG_HOST}"

# Quiet hours (Africa/Algiers)
EVOSALES_COMPANY=Evotechly
EVOSALES_QUIET_START=21:00
EVOSALES_QUIET_END=08:00

# Email verification: disabled is fail-closed. Use dns for syntax/MX evidence
# only, or http for an approved provider with a normalized JSON response.
EVOSALES_EMAIL_VERIFICATION_DRIVER=disabled
EVOSALES_EMAIL_VERIFICATION_PROVIDER=http
EVOSALES_EMAIL_VERIFICATION_URL=
EVOSALES_EMAIL_VERIFICATION_API_KEY=
EVOSALES_EMAIL_VERIFICATION_TIMEOUT=8
EVOSALES_EMAIL_VERIFICATION_CACHE_HOURS=168

# --- Live mail stack (EvoOutreach) at outbound.evotechly.com ---
# The CRM uses the stack for SMTP send + IMAP replies + Roundcube webmail
# only. Set the API token and every mailbox on the stack syncs into
# Outbound → Mailboxes automatically (outbound:sync-mailboxes, every 15 min,
# or the Sync button on the page). The stack's own marketing dashboard is
# never linked — campaigns and sequences live here in the CRM.
EVOSALES_MAIL_API_URL=https://outbound.evotechly.com
EVOSALES_MAIL_API_TOKEN=
EVOSALES_SMTP_HOST=outbound.evotechly.com
EVOSALES_SMTP_PORT=587
EVOSALES_SMTP_ENCRYPTION=tls
EVOSALES_IMAP_HOST=outbound.evotechly.com
EVOSALES_IMAP_PORT=993
EVOSALES_IMAP_ENCRYPTION=ssl
EVOSALES_ROUNDCUBE_URL=https://outbound.evotechly.com/roundcube/

# Outbound consent policy: keep enabled unless a documented lawful-basis
# review explicitly authorizes cold B2B outreach for the intended market.
EVOSALES_REQUIRE_MARKETING_CONSENT=true
# Conservative outbound defaults: uncertain verification states stay blocked.
EVOSALES_BLOCK_CATCH_ALL_EMAIL=true
EVOSALES_BLOCK_UNKNOWN_EMAIL=true
